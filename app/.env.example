# Copy to .env and adjust. Never commit real secrets.
DATABASE_URL=postgres://clinic:clinic@localhost:5432/clinic_dev
PORT=3000
# 32-byte key, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
# Secret that derives visit and form link tokens
LINK_SECRET=
# Public base URL used in text-message links
PUBLIC_URL=http://localhost:5173
# Text provider: "fake" logs messages to the database (default until a provider is chosen)
SMS_PROVIDER=fake
